# OpenAI
OPENAI_API_KEY=

# Google AI / Gemini
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash
GOOGLE_AI_IMAGE_MODEL=gemini-3.1-flash-image
YOUTUBE_DATA_API_KEY=
YOUTUBE_CHANNEL_HANDLE=@AzureInkblade
YOUTUBE_CHANNEL_ID=
GEMINI_MARKETING_TEMPERATURE=0.85

# Image fallback search
PEXELS_API_KEY=
PIXABAY_API_KEY=
PIXABAY_MIN_DIMENSION=900
IMAGE_BANK_MINIMUM=50

# Optional local Stable Diffusion image fallback
# Used after OpenAI/Gemini and before stock image providers when dependencies are installed.
LOCAL_SD_ENABLED=1
LOCAL_SD_MODEL=stabilityai/stable-diffusion-xl-base-1.0
LOCAL_SD_REFINER_MODEL=stabilityai/stable-diffusion-xl-refiner-1.0
LOCAL_SD_QUALITY_MODE=balanced
LOCAL_SD_REBUILD_QUALITY_MODE=balanced
LOCAL_SD_SCHEDULER=dpm
LOCAL_SD_IMG2IMG_STRENGTH=0.56
LOCAL_SD_TIMEOUT_SECONDS=900
LOCAL_SD_VERTICAL_WIDTH=768
LOCAL_SD_VERTICAL_HEIGHT=1344
LOCAL_SD_HORIZONTAL_WIDTH=1344
LOCAL_SD_HORIZONTAL_HEIGHT=768
LOCAL_SD_STEPS=0
LOCAL_SD_GUIDANCE_SCALE=0
LOCAL_SD_NEGATIVE_PROMPT=text, typography, watermark, logo, blurry, low quality, distorted hands, extra fingers, duplicate face

# Instagram publishing
# Use the provided Instagram professional account id and a Meta access token
# with Instagram content publishing permissions.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Instagram requires a public HTTPS URL for the image. This should point to
# wherever you host or mirror the social-posts folder.
INSTAGRAM_PUBLIC_BASE_URL=https://example.com/social-posts

# X publishing
# Use an OAuth 2.0 user access token with tweet.write and media.write.
X_ACCESS_TOKEN=

# Buffer publishing hub
BUFFER_API_KEY=
BUFFER_CHANNEL_IDS=
BUFFER_PUBLIC_BASE_URL=https://your-public-host/social-posts

# GitHub Pages media hosting
GITHUB_REMOTE_URL=https://github.com/azureinkblade-ops/Automation-tool.git
GITHUB_MEDIA_REMOTE_URL=https://github.com/azureinkblade-ops/Automation-Media.git
GITHUB_PAGES_MEDIA_BASE_URL=https://raw.githubusercontent.com/azureinkblade-ops/Automation-Media/main/media
GITHUB_TOKEN=
GITHUB_AUTO_PUBLISH_MEDIA=1

# Cloudflare R2 media hosting for Buffer
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=novel-promo-media
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Local asset folders
BACKGROUND_VIDEO_DIR=C:\Users\David\Documents\Novels
CLOUDFLARE_MEDIA_DIR=C:\Users\David\Documents\CloudFlare
PROMO_IMAGES_DIR=C:\Users\David\Documents\CloudFlare
TIKTOK_ASSET_DIR=C:\Users\David\Documents\CloudFlare
