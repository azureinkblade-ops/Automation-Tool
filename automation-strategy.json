{
  "schemaVersion": 1,
  "updatedAt": "2026-07-11 00:00:00",
  "imageProviderPriority": [
    "local_stable_diffusion",
    "openai",
    "google_ai",
    "banked",
    "pexels",
    "pixabay",
    "local_fallback"
  ],
  "videoProviderPriority": [
    "pexels",
    "pixabay",
    "local_backgrounds",
    "banked"
  ],
  "quotaRules": {
    "preferBankedImagesWhenOpenAIRateLimited": true,
    "minimumImageReuseCooldownDays": 21,
    "targetImagesPerNovelBeforeReuse": 50
  },
  "youtube": {
    "endScreensEnabled": true,
    "pollsEnabled": true,
    "endScreenElements": [
      "subscribe",
      "best_for_viewer",
      "same_novel_playlist",
      "latest_upload"
    ],
    "pollCadence": "weekly"
  },
  "analytics": {
    "autoApplyWinners": false,
    "minimumVariantScoreForWinner": 0.65,
    "minimumViewsForDecision": 100
  },
  "localImage": {
    "defaultModel": "models/sdxl-base when available, otherwise stabilityai/stable-diffusion-xl-base-1.0",
    "qualityMode": "premium",
    "rebuildMode": "image-to-image when a rejected/weak source image exists",
    "promptBoost": "chapter-specific manhwa/anime web-novel composition, strong subject separation, no generic landscape",
    "futureTraining": "Export approved images and prompts into LoRA tracks before training.",
    "loraEnabled": true,
    "loraTracks": [
      "main-posts",
      "comic-style",
      "realistic-posts"
    ]
  },
  "loraTraining": {
    "root": "lora-training",
    "activeWeightsRoot": "loras",
    "tracks": {
      "main-posts": {
        "triggerToken": "azink_main",
        "use": "Daily chapter promos, Patreon/X/Facebook images, and general novel campaign art."
      },
      "comic-style": {
        "triggerToken": "azink_comic",
        "use": "Deep TikTok, Shorts/Reels, story hooks, and comic-style chapter moments."
      },
      "realistic-posts": {
        "triggerToken": "azink_real",
        "use": "Realistic promotional posts, darker story hook thumbnails, and non-comic experiments."
      }
    }
  }
}
